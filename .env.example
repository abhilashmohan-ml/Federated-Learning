# ============================================================
# Server settings
# ============================================================
SERVER_SECRET_KEY=CHANGE_ME_strong_random_64_chars
SERVER_DB_URL=postgresql+asyncpg://viral_fl:viral_fl_pass@db:5432/viral_fl
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FLET_SERVER_PORT=8550

# CORS origins — JSON array format (required by pydantic-settings v2).
# Dev:  CORS_ORIGINS=[]   (empty array = allow all origins, no credentials)
# Prod: CORS_ORIGINS=["https://site1.company.com:8551","https://site2.company.com:8552"]
CORS_ORIGINS=[]

# TLS / HTTPS (optional).  Both must be set together.
# Dev:  run scripts/generate_certs.sh then set paths below.
# Prod: use Let's Encrypt or your CA; see docs/PRODUCTION.md.
# SSL_KEYFILE=/certs/server.key
# SSL_CERTFILE=/certs/server.crt

# ============================================================
# Site registration (run scripts/init_db.py after setting this)
# Format: comma-separated site_id:secret pairs.
# Omit the secret to auto-generate one (it will be printed — copy it to the
# matching site's SITE_SECRET env var).
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
REGISTERED_SITES=site_1:CHANGE_ME_site1_secret,site_2:CHANGE_ME_site2_secret,site_3:CHANGE_ME_site3_secret

# ============================================================
# Per-site secrets for Docker Compose substitution only.
# docker-compose.yml maps SITE_N_SECRET → the container's SITE_SECRET env var.
# In production each site sets SITE_SECRET directly in its own environment.
# ============================================================
SITE_1_SECRET=CHANGE_ME_site1_secret
SITE_2_SECRET=CHANGE_ME_site2_secret
SITE_3_SECRET=CHANGE_ME_site3_secret
SITE_4_SECRET=CHANGE_ME_site4_secret
SITE_5_SECRET=CHANGE_ME_site5_secret

# Secret the FL server uses when polling /site/status on each client.
# In Docker Compose all clients share a single poll secret.
# Must match SITE_SECRET on each client (or be a separate dedicated secret).
SITE_POLL_SECRET=CHANGE_ME_site_poll_secret

# ============================================================
# Client settings  (one .env per site container)
# ============================================================
SITE_ID=site_1
SITE_SECRET=CHANGE_ME_site1_secret
# Dev (Docker): http://server:8000
# Dev (venv):   http://localhost:8000
# Production:   https://fl-server.company.com  (or public IP)
SERVER_URL=http://server:8000
FLET_CLIENT_PORT=8551
DP_NOISE_SIGMA=0.01
# AUTO_SCHEDULE — set true to re-enable auto-training in dev mode (not recommended for manual demos)
# AUTO_SCHEDULE=false
# LOCAL_DATA_PATH — auto-derived from SITE_ID when not set
#                   Docker compose sets this explicitly per container; venv dev does not need it

# SSL verification — set false only when using self-signed dev certs
VERIFY_SSL=true
# Connection / request timeouts in seconds
CONNECT_TIMEOUT=10
REQUEST_TIMEOUT=60
# Retries on transient network errors (exponential backoff: 2s, 4s, 8s …)
RETRY_ATTEMPTS=3

# ============================================================
# Shared FL hyperparameters
# ============================================================
LOG_LEVEL=INFO
FL_ROUNDS=50
LOCAL_EPOCHS=5
LEARNING_RATE=0.001
FEDPROX_MU=0.01
MIN_SITES_PER_ROUND=3
ROUND_TIMEOUT_SECONDS=300
